module sram (
    input  wire       clk,        // Clock input
    input  wire       rst_n,      // Active low reset
    input  wire       bank_addr,  // Bank address (2 banks)
    input  wire [3:0] row_addr,   // Row address (4 rows)
    input  wire [7:0] col_addr,   // Column address (4 columns)
    input  wire [7:0] wr_data,    // Data to write to memory (8-bit)
    input  wire       wr_en,      // Write enable signal
    input  wire       rd_en,      // Write enable signal
    output wire [7:0] rd_data     // Data read from memory (8-bit)
);

