module i2c_master_control ( //non synthesizable RTL
    input  wire        clk,           // System clock
    input  wire        rst_n,         // Active-low reset
    input  wire        start,         // Start signal for I2C transmission
    input  wire [7:0]  data_in,       // 8-bit data to be transmitted
    input  wire [6:0]  slave_addr,    // 7-bit I2C slave address
    input  wire [15:0] scl_low_time,  // SCL low time (dynamic configuration)
    input  wire [15:0] scl_high_time, // SCL high time (dynamic configuration)
    input  wire [15:0] sda_hold_time, // SDA setup time (dynamic configuration)
    output reg         scl,           // I2C clock signal (SCL)
    output reg         sda,           // I2C data signal (SDA)
    output reg         done           // Done signal, indicates transmission completion
);


